-- ---------------------------------------------------------------------------
-- The prototype opens with the first article selected but still unread — its
-- header reads "12 articles · 9 unread". Marking it read on open cost a count,
-- so the initial selection now only sets the active article; reading is what
-- clicking a row does.
-- ---------------------------------------------------------------------------

/**
 * Build the reader state and open the app.
 *
 * The home microflow: creates the non-persistent view and selects the newest
 * article so the detail pane is never empty.
 *
 * @returns true
 */
create or replace microflow Feedline.ACT_OpenReader ()
returns boolean as $ok
folder 'Logic'
begin
  $View = create Feedline.ReaderView (Kind = Feedline.ViewKind.All, Query = '', LastRefresh = 'just now');
  retrieve $First from Feedline.Article sort by Feedline.Article.SortOrder asc limit 1;
  if $First != empty then
    set $View/Feedline.ReaderView_ActiveArticle = $First;
  end if;
  $CountsOk = call microflow Feedline.ACT_RecalculateCounts();
  call microflow Feedline.SUB_RefreshView(View = $View);
  show page Feedline.Reader(View: $View);
  return true;
end;
/
