-- ---------------------------------------------------------------------------
-- Schema for real feed fetching.
--
-- Articles now come from a live HTTP call rather than the seed, so they need
-- somewhere to keep the source URL (which also gives "Open original" something
-- to point at) and the feed needs somewhere to report how the last fetch went.
-- ---------------------------------------------------------------------------

/**
 * The article's own URL, from <link> (RSS) or <link href="…"> (Atom).
 * Doubles as the dedupe key across refreshes.
 */
alter entity Feedline.Article add attribute Link: string(1000);
/

/**
 * Raw <pubDate>/<updated> text, kept so a parse failure is diagnosable rather
 * than silently becoming "now".
 */
alter entity Feedline.Article add attribute PubDateRaw: string(100);
/

/**
 * Outcome of the last fetch for this feed, shown in Manage feeds & tags.
 */
alter entity Feedline.Source add attribute LastFetchStatus: string(200) default 'never fetched';
/

/**
 * How many articles the last fetch added.
 */
alter entity Feedline.Source add attribute LastFetchNew: integer default 0;
/
