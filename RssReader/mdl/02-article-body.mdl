-- ---------------------------------------------------------------------------
-- The detail pane renders the article body as separate <p> blocks. Modelling
-- them as four attributes (rather than one blob with newlines) lets each
-- paragraph be its own dynamictext with its own visibility condition, which is
-- what the prototype's typography needs.
-- ---------------------------------------------------------------------------

alter entity Feedline.Article drop attribute Body;
/

alter entity Feedline.Article add attribute BodyP1: string(2000);
/
alter entity Feedline.Article add attribute BodyP2: string(2000);
/
alter entity Feedline.Article add attribute BodyP3: string(2000);
/
alter entity Feedline.Article add attribute BodyP4: string(2000);
/
