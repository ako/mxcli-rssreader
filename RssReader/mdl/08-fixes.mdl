-- ---------------------------------------------------------------------------
-- Fixes for the errors mxbuild found.
--
-- 1. A widget expression cannot traverse an association. `contentparams` over
--    `Article_Source/Mono` is fine (that is a data binding), but
--    `dynamicclasses: '...' + $currentObject/Feedline.Article_Source/Slug` is
--    CE0117. The badge tint has to come from an attribute on the article
--    itself, so the source slug is denormalised onto Article — the same
--    trade-off already made for the unread counters.
--
-- 2. `retrieve $Existing ... limit 1` then `$Existing = create ...` is CE0111
--    (duplicate variable) — the retrieve already declares it.
-- ---------------------------------------------------------------------------

alter entity Feedline.Article add attribute SourceSlug: string(40);
/

/**
 * Create one article against the feed identified by its slug.
 *
 * Word count and the meta line follow the prototype's own formulas
 * (words = 700 + minutes * 40) so the rendered numbers match the design.
 *
 * @param $SourceSlug Slug of the owning feed
 * @param $Minutes Reading time in minutes
 * @param $TimeLabel Relative age shown in the list row (e.g. '15h')
 * @param $Title Headline
 * @param $Excerpt Standfirst, shown in the row and as the detail lead
 * @param $P1 Body paragraph 1
 * @param $P2 Body paragraph 2
 * @param $P3 Body paragraph 3
 * @param $P4 Body paragraph 4 (may be empty)
 * @param $IsRead Read state
 * @param $IsStarred Starred state
 * @param $IsSaved Read-later state
 * @param $SortOrder Position in the default list
 * @returns The new article
 */
create or replace microflow Feedline.SUB_CreateArticle (
  $SourceSlug: string,
  $Minutes: integer,
  $TimeLabel: string,
  $Title: string,
  $Excerpt: string,
  $P1: string,
  $P2: string,
  $P3: string,
  $P4: string,
  $IsRead: boolean,
  $IsStarred: boolean,
  $IsSaved: boolean,
  $SortOrder: integer
)
returns Feedline.Article as $Article
folder 'Seed'
begin
  retrieve $Source from Feedline.Source where [Slug = $SourceSlug] limit 1;
  declare $Words integer = 700 + $Minutes * 40;
  $Article = create Feedline.Article (
    Title = $Title,
    Excerpt = $Excerpt,
    BodyP1 = $P1,
    BodyP2 = $P2,
    BodyP3 = $P3,
    BodyP4 = $P4,
    Minutes = $Minutes,
    Words = $Words,
    TimeLabel = $TimeLabel,
    SourceSlug = $SourceSlug,
    MetaLine = toString($Minutes) + ' min read · ' + toString($Words) + ' words · today, 07:12',
    IsRead = $IsRead,
    IsStarred = $IsStarred,
    IsSaved = $IsSaved,
    PublishedAt = [%CurrentDateTime%],
    SortOrder = $SortOrder);
  set $Article/Feedline.Article_Source = $Source;
  commit $Article;
  return $Article;
end;
/

/**
 * Create a tag from the sheet's text box and apply it to the active article.
 *
 * Reuses an existing tag when the name already exists, which is what makes the
 * tag layer shared rather than per-article strings.
 *
 * @param $View The reader state
 * @returns true
 */
create or replace microflow Feedline.ACT_CommitNewTag (
  $View: Feedline.ReaderView
)
returns boolean as $ok
folder 'Logic'
begin
  declare $Name string = trim($View/TagDraft);
  if $Name = '' then
    return true;
  end if;
  -- A retrieve declares its own output variable, so the "reuse or create"
  -- branch needs two distinct names rather than one reassigned one (CE0111).
  retrieve $Match from Feedline.Tag where [Name = $Name] limit 1;
  if $Match != empty then
    change $View (TagDraft = '') refresh;
    call microflow Feedline.ACT_ToggleTag(View = $View, Tag = $Match);
    return true;
  end if;
  retrieve $AllTags from Feedline.Tag;
  $TagCount = count($AllTags);
  $NewTag = create Feedline.Tag (
    Name = $Name,
    Slug = 'custom',
    SortOrder = $TagCount + 1);
  commit $NewTag;
  change $View (TagDraft = '') refresh;
  call microflow Feedline.ACT_ToggleTag(View = $View, Tag = $NewTag);
  return true;
end;
/
