-- ---------------------------------------------------------------------------
-- Smart-view wrappers.
--
-- A Mendix button can map an object from the page context but cannot pass a
-- literal argument, so the four sidebar entries each need a thin wrapper that
-- supplies its ViewKind to the shared ACT_SelectView.
-- ---------------------------------------------------------------------------

/**
 * Show every article.
 *
 * @param $View The reader state
 * @returns true
 */
create microflow Feedline.ACT_ViewAll (
  $View: Feedline.ReaderView
)
returns boolean as $ok
folder 'Logic/Views'
begin
  $r = call microflow Feedline.ACT_SelectView(View = $View, Kind = Feedline.ViewKind.All);
  return $r;
end;
/

/**
 * Show unread articles only.
 *
 * @param $View The reader state
 * @returns true
 */
create microflow Feedline.ACT_ViewUnread (
  $View: Feedline.ReaderView
)
returns boolean as $ok
folder 'Logic/Views'
begin
  $r = call microflow Feedline.ACT_SelectView(View = $View, Kind = Feedline.ViewKind.Unread);
  return $r;
end;
/

